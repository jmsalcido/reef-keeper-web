# Used by the Cloudflare Worker locally. Keep the API key server-side.
MAILGUN_API_KEY="key-your-mailgun-api-key"
MAILGUN_DOMAIN="mg.example.com"
# Optional. Defaults to Reef Keeper Support <mailgun@MAILGUN_DOMAIN>.
# MAILGUN_FROM_EMAIL="Reef Keeper Support <support@mg.example.com>"

# Use https://api.eu.mailgun.net if your Mailgun domain is in the EU region.
# MAILGUN_API_BASE_URL="https://api.eu.mailgun.net"
