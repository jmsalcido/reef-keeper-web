{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reefkeeper-landing",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
